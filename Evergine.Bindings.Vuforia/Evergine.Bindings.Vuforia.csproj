<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Copyright>Copyright (c) Evergine 2026</Copyright>
		<Authors>Evergine Team</Authors>
		<Company>Plain Concepts</Company>
		<Description>Low-level bindings for Vuforia Engine used in Evergine</Description>
		<RepositoryUrl>https://github.com/EvergineTeam/Vuforia.NET</RepositoryUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseFile>PACKAGE-LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<Folder Include="Generated\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Evergine.Mathematics" Version="2026.5.26.682" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="runtimes\**" PackagePath="runtimes" Visible="true" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="buildTransitive\**" PackagePath="buildTransitive" Visible="true" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="*.jar" PackagePath="." Visible="true" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\PACKAGE-LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
